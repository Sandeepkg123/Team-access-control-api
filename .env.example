PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string_here
NODE_ENV=development

# REQUIRED — the server refuses to boot without these (see src/config/env.js).
# Generate a fresh value for each; never reuse one secret for both.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_unique_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_random_string_at_least_32_chars

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# OPTIONAL. Lets test.js / smoke.js / final-check.js bypass the rate limiters
# while they run. The server compares this value against the x-test-suite
# request header for equality, so leaving it unset simply disables the bypass —
# which is what a production deployment should do. Without it those suites will
# start receiving 429s partway through a run.
TEST_SUITE_SECRET=

# Only needed behind a reverse proxy — number of hops, or "true" for one.
# Leave blank on localhost.
TRUST_PROXY=